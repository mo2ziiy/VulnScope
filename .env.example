# VulnScope local environment — PLACEHOLDERS ONLY.
# Copy to `.env` for local use. Never commit `.env`, and never put real credentials in this file.
# Values are intentionally empty unless they are safe, non-secret defaults.

# Runtime
APP_ENV=local

# Scanner safety: external scanning stays disabled locally and in CI (RoE-1 §16).
SCANNER_ALLOW_EXTERNAL=false

# Database / brokers (services arrive in Task 01.1b)
DATABASE_URL=
REDIS_CORE_URL=
REDIS_SCAN_URL=

# Auth (Supabase local CLI, Task 03.1). Service-role key is core-zone only (ADR-0003).
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
